(test 1 (vector-argmax #(1 3 2)))
(test 1 (vector-argmin #(1 3 2) >))
(test 'empty-arg (guard (e (#t 'empty-arg)) (vector-argmin #())))

(test 1 (vector-index-of #(1 2 3) 2))
