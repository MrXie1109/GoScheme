(test 'too-long (guard (e (#t 'too-long)) (vector-drop 5 #(1))))
(test #(1 2 3) (vector-concat (list #(1 2) #(3))))
(test #() (vector-concat '()))
(test 'bad-concat (guard (e (#t 'bad-concat)) (vector-concat (list #(1) 2))))

(test '(0 1 2 3 4) (range 0 5))
