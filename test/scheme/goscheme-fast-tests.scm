(test '(#(1 2) #(3 4) #(5)) (vector-chunk #(1 2 3 4 5) 2))
(test '() (vector-chunk #() 3))
(call-with-values (lambda () (vector-partition even? #(1 2 3 4)))
  (lambda (a b) (test #(2 4) a) (test #(1 3) b)))

(test 2 (vector-binary-search-insert #(1 3 5) 4))
(test 1 (vector-binary-search-insert #(1 3 5) 3))
(test 0 (vector-binary-search-insert #(1 3 5) 0))
(test 3 (vector-binary-search-insert #(1 3 5) 9))
(test 2 (vector-binary-search-insert #("a" "c" "e") "d" string<?))
(test 0 (vector-binary-search-insert #() 1))

(test #t (vector-equal? #(1 2) #(1 2)))
(test #f (vector-equal? #(1 2) #(1 3)))
(test #f (vector-equal? #(1 2) #(1 2 3)))
(test #t (vector-equal? #()))
(test #t (vector-equal? #(1 2) #(1 2) #(1 2)))
(test #f (vector-equal? #(1 2) #(1 2) #(9)))

(test -1 (vector-compare #(1 2) #(1 3)))
(test 1 (vector-compare #(1 3) #(1 2)))
(test 0 (vector-compare #(1 2) #(1 2)))
(test -1 (vector-compare #(1) #(1 2)))
(test 1 (vector-compare #(1 2) #(1)))
(test 1 (vector-compare #("b") #("a") string<?))
(test -1 (vector-compare #("a") #("b") string<?))

(define batch1 (vector 1 2))
(test #t (eq? batch1 (vector-add! batch1 #(10 20))))
(test #(11 22) batch1)
(define batch2 (vector 1 2))
(vector-sub! batch2 #(10 20))
(test #(-9 -18) batch2)
(define batch3 (vector 1 2))
(vector-mul! batch3 #(3 4))
(test #(3 8) batch3)
(define batch4 (vector 1 2))
(vector-div! batch4 #(4 8))
(test #(1/4 1/4) batch4)
(define batch5 (vector 1 2))
(vector-scale! batch5 10)
(test #(10 20) batch5)
(define batch6 (vector 1 -2))
(vector-negate! batch6)
(test #(-1 2) batch6)
(define batch7 (vector 1 -2))
(vector-abs! batch7)
(test #(1 2) batch7)
(define batch8 (vector -1 5 15))
(vector-clamp! batch8 0 10)
(test #(0 5 10) batch8)

(test-end)

